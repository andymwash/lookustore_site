# ── These go in Netlify → Site configuration → Environment variables (NOT in the website files) ──

# Supabase → Connect → "Transaction pooler" URI (port 6543). Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:6543/postgres

# Signs the staff logins. A long random string, 32+ characters. If someone learns it they can forge logins, so keep it secret.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Used ONCE, to create the very first manager account on the website's setup page (8+ characters).
SETUP_KEY=

# ── M-Pesa prompt (optional — leave out until you have your own Paybill/Till; checkout then uses manual payment) ──
# MPESA_ENVIRONMENT=sandbox        (use "production" when live)
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://YOUR-SITE.netlify.app/api/mpesa/callback
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   (Till numbers: CustomerBuyGoodsOnline)
# MPESA_PARTY_B=                                 (Till numbers only: the Till number)
